# Binaries
terraform-provider-omni
dist/
bin/

# Go
*.test
*.out
vendor/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
crash.log
# Variable files are committed: they hold configuration, not secrets. Secrets
# come from TF_VAR_ environment variables fed by a secret store.
*.tfvars
!infra/*.auto.tfvars
!infra/examples/*.tfvars

# Editors and OS
.idea/
.vscode/
.DS_Store

# Local dev overrides
.terraformrc
terraform.rc

# The lock file is committed on purpose: CI installs the provider from a
# filesystem mirror and needs the recorded checksums.
